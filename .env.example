DB_HOST=your-mysql-host
DB_PORT=3306
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_DATABASE=gzura_development
DB_SSL=false
DB_SYNC=false

JWT_SECRET=generate-a-strong-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://gzura.com,https://gzura.com
PORT=8001
FRONTEND_URL=http://localhost:3000

# Email delivery with Resend. MAIL_FROM must use a verified Resend domain.
RESEND_API_KEY=
MAIL_FROM="GZURA <noreply@your-verified-domain.com>"
MAIL_TIMEZONE=Asia/Kolkata
# Optional extra recipient for admin notification emails in development.
DEV_ADMIN_EMAIL=

# Twilio (phone OTP + password reset SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567
# Optional instead of TWILIO_PHONE_NUMBER:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay (paid event enrollment)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google OAuth (Sign in with Google + Calendar/Meet)
# GCP → Credentials → OAuth 2.0 Web client
# Authorized JavaScript origins: http://localhost:3001, https://gzura.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=

# Option B: Service account with domain-wide delegation
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=

GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# Google Maps / Places (location search for offline events)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Event thumbnail uploads
# local = save on this server (use for localhost/dev).
# sftp = push to Hostinger VPS public folder (production only).
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./uploads/events
UPLOAD_PUBLIC_URL=http://localhost:8001/uploads/events
UPLOAD_CONTENT_PUBLIC_URL=http://localhost:8001/uploads/event-content
UPLOAD_CONTENT_LOCAL_DIR=./uploads/event-content
UPLOAD_DOMAIN=gzura.com

# Hostinger VPS (SFTP) — required only when UPLOAD_STORAGE=sftp
# If you see "Timed out while waiting for handshake", the VPS is unreachable
# from this machine (firewall/port 22). Use UPLOAD_STORAGE=local for local dev.
SFTP_HOST=your-vps-ip
SFTP_PORT=22
SFTP_USER=your-ssh-username
SFTP_PASSWORD=your-ssh-password
# SFTP_PRIVATE_KEY_PATH=/path/to/id_rsa
# SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_REMOTE_PATH=/home/your-user/domains/gzura.com/public_html/uploads/events
SFTP_CONTENT_REMOTE_PATH=/home/your-user/domains/gzura.com/public_html/uploads/event-content
